# stage 1: build React app and compile Express server
FROM node:20-slim AS builder
WORKDIR /app
COPY apps/media-library/package*.json ./
RUN npm ci
COPY apps/media-library/ ./
RUN npm run build

# stage 2: run Express + static assets
FROM node:20-slim
WORKDIR /app
COPY --from=builder /app/package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/server ./server
EXPOSE 8080
CMD ["node", "server/dist/index.js"]
